<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp">
    <EditText android:id="@+id/etOld" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="原密码（首次留空）"
        android:inputType="numberPassword" android:maxLength="4" />
    <EditText android:id="@+id/etNew" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="新密码（4 位数字）"
        android:inputType="numberPassword" android:maxLength="4" />
    <EditText android:id="@+id/etNew2" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:hint="再输一次新密码"
        android:inputType="numberPassword" android:maxLength="4" />
    <Button android:id="@+id/btnVerify" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="验证并退出锁定" />
    <Button android:id="@+id/btnChange" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:text="修改家长密码" />
</LinearLayout>
