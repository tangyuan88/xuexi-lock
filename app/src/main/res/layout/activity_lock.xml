<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">
    <TextView android:id="@+id/tvProgress" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginBottom="16dp" />
    <TextView android:id="@+id/tvStem" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold"
        android:minHeight="100dp" android:gravity="center" />
    <Button android:id="@+id/optA" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/optB" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/optC" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/optD" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/btnParent" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:text="家长入口" android:layout_marginTop="24dp" />
</LinearLayout>
